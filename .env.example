# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit it, and never paste a real key into any
# file that is committed. See the Secrets section of CLAUDE.md.

# LINZ Data Service API key, used by netlify/functions/roof-area.js to look up
# building outlines. Get one free at https://data.linz.govt.nz (My account →
# API keys). Server-side only.
#
# IMPORTANT: do NOT name this REACT_APP_LINZ_API_KEY. Create React App bakes
# every REACT_APP_* variable into the published JavaScript bundle, where anyone
# can read it by viewing source. This name is deliberately not prefixed so it
# stays on the server.
LINZ_API_KEY=

# LINZ *Basemaps* key — a DIFFERENT key from the one above. Used only by
# netlify/functions/tile.js for aerial photos on the "draw it on a map" tool.
# The Data Service key above is rejected by Basemaps ("API Key Invalid:
# malformed"). Ask basemaps@linz.govt.nz for a free developer key (does not
# expire). Without it the map uses the OpenStreetMap street map instead.
LINZ_BASEMAPS_KEY=

# REACT_APP_BACKEND_URL is no longer used. Enquiries go to
# netlify/functions/enquiry.mjs at /api/enquiry.
